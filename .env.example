# ---------------------------------------------------------------------------
# VIDsigner MCP server / client. Copy this file to .env (it is in .gitignore).
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Environment: pre (pre-production, default) | pro (production).
# In pro the server starts READ-ONLY (see the ALLOW_* variables below).
VIDSIGNER_ENV=pre

# Optional override of the signature API base URL. It must be https:// without user:password, without
# a port, without a query and with the EXACT path /api/v3.0 and the signature API host of the
# environment. Defaults:
#   pre -> https://pre-vidsignercloud.validatedid.com/api/v3.0
#   pro -> https://vidsignercloud.validatedid.com/api/v3.0
# VIDSIGNER_BASE_URL=
# Only to test against a local server (localhost / 127.0.0.1, also over http://), and to use
# http://localhost as NotificationURL in webhook tests.
# Only allowed with VIDSIGNER_ENV=pre: with pro the server refuses to start.
# VIDSIGNER_ALLOW_LOCAL_HOSTS=false

# OAuth client (issued by Validated ID). Needed to WRITE (POST/PUT/DELETE): writes require a JWT.
# Without them only reads work, with Basic authentication.
VIDSIGNER_CLIENT_ID=
VIDSIGNER_CLIENT_SECRET=

# Subscription credentials (Basic for reads; user/password of the JWT).
VIDSIGNER_SUBSCRIPTION_NAME=
VIDSIGNER_SUBSCRIPTION_PASS=

# --- Safety gates ------------------------------------------------------------
# Writes (create documents, send reminders...). Default: true in pre, false in pro.
# VIDSIGNER_ALLOW_WRITE=false
# Destructive operations (any DELETE, PUT .../expire). Default: ALWAYS false.
# VIDSIGNER_ALLOW_DESTRUCTIVE=false
# GET /signeddocuments/{id} marks the document as DOWNLOADED. Default: true in pre, false in pro.
# VIDSIGNER_ALLOW_MARK_DOWNLOADED=false
# SENSITIVE read: the signing link (GET /signature/{SignerGUID}/vidremoteurl) lets whoever opens it
# sign. It carries no readOnlyHint. Default: true in pre, false in pro.
# It only covers vidsigner_get_signature_url.
# VIDSIGNER_ALLOW_SIGNING_LINKS=false
# Management CREDENTIAL reads: the token of a VIDmobile user (GET /vidmobileusers/{legalid}/token)
# and device enrollment codes (GET .../enrollmentcode). They carry no readOnlyHint.
# Default: true in pre, false in pro.
# VIDSIGNER_ALLOW_CREDENTIAL_READS=false

# --- Management API (MGMT 1.0) --------------------------------------------------
# The management tools are only registered with VIDSIGNER_ENABLE_MGMT=true.
VIDSIGNER_ENABLE_MGMT=false
# Same rules as VIDSIGNER_BASE_URL, with the MANAGEMENT API host and the exact path /api.
# Defaults:
#   pre -> https://pre-vidsignercloudmgmt.validatedid.com/api
#   pro -> https://vidsignercloudmgmt.validatedid.com/api
# VIDSIGNER_MGMT_BASE_URL=
# Management OAuth client (if not set, VIDSIGNER_CLIENT_ID/SECRET are used).
VIDSIGNER_MGMT_CLIENT_ID=
VIDSIGNER_MGMT_CLIENT_SECRET=
# PARTNER credentials (scope=partner): partners, customers, subscriptions, enrollment codes.
VIDSIGNER_MGMT_PARTNER_USER=
VIDSIGNER_MGMT_PARTNER_PASS=

# --- Files -----------------------------------------------------------------------
# Paths must be ABSOLUTE; "~" and "~/" are expanded. Relative ones (".", "folder") and
# "~otheruser" are rejected at startup. A .env file does NOT expand $HOME or other variables.
# Folder where downloaded PDFs, reports and credentials are saved (default:
# <tmp>/vidsigner-mcp). It is created at startup with mode 0700 if it does not exist.
# VIDSIGNER_OUTPUT_DIR=~/vidsigner-mcp/out
# Folders (comma-separated) from which files may be READ for upload.
# There is ALWAYS a list: if not set, only ~/vidsigner-mcp/in. Any path outside them is rejected;
# the filesystem root and the home directory are not accepted. Anti-exfiltration. If a folder does
# not exist, startup warns about it (it does not create it).
# VIDSIGNER_ALLOWED_INPUT_DIRS=~/vidsigner-mcp/in
# Maximum upload size in MB (default 20).
# VIDSIGNER_MAX_UPLOAD_MB=20

# --- Recipient allow-lists (RECOMMENDED IN PRODUCTION) ------------------------------------
# When set, any email, phone number, notification URL or asset URL that does not match is rejected
# before calling the API. Empty = no restriction. Comma-separated entries.
# The FORMAT is always validated, with or without lists: each email or phone must be ONE address or
# number ("a@example.org;b@example.net", "a@example.org b@example.net", "+34600111222,+1555000111" are rejected).
# Email domains (signers, SignedDocumentRecipients, RejectedDocumentRecipients, e-delivery...):
# VIDSIGNER_ALLOWED_EMAIL_DOMAINS=example.com,*.example.com
# Phone prefixes of signers and recipients:
# VIDSIGNER_ALLOWED_PHONE_PREFIXES=+34
# Hosts of NotificationURL and returnUrl:
# VIDSIGNER_ALLOWED_NOTIFICATION_HOSTS=hooks.example.com
# Hosts of the RESOURCE URLs that VIDsigner shows to signers: Appearance.APP.Logo (and App),
# EmailNotification.CorporateLogo and CustomerURL. A SEPARATE list from the notification one (a
# logo CDN is not a webhook destination).
# VIDSIGNER_ALLOWED_ASSET_HOSTS=cdn.example.com

# --- HTTP client ---------------------------------------------------------------------
# VIDSIGNER_TIMEOUT_MS=30000
# VIDSIGNER_MAX_RETRIES=2
# Log level (to stderr): debug | info | warn | error | silent
# VIDSIGNER_LOG_LEVEL=info

# --- Only for the optional integration test (tests/integration) -----------------------
# VIDSIGNER_IT=1 npm run test:it   (reads only, never creates or sends anything)
# VIDSIGNER_IT=1
# Path of the .env file the integration test loads (default ./.env).
# VIDSIGNER_IT_ENV_FILE=
